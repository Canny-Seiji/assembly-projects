{
    "name": "NASM x86 Assembly",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

    "postCreateCommand": "sudo apt-get update && sudo apt-get install -y nasm binutils gdb gcc-multilib",

    "customizations": {
        "vscode": {
            "settings": {
                "files.associations": {
                    "*.asm": "asm-collection"
                }
            }
        }
    }
}